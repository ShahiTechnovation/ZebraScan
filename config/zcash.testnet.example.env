# HACKATHON_TESTNET overlay — copy to var/secrets/testnet.env (git-ignored). No secrets here.
ZEB_ENVIRONMENT=HACKATHON_TESTNET
ZCASH_NETWORK=testnet
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/zebscan_testnet
# Written by `pnpm zkool:bootstrap --network testnet --url https://<svc>/graphql` → var/secrets/testnet-worker.env
ZKOOL_GRAPHQL_URL=https://<zebscan-zcash-test>.onrender.com/graphql
ZKOOL_NETWORK=testnet
ZKOOL_ACCOUNT_ID=<watch-only account id>
ZKOOL_BIRTH_HEIGHT=<birth height>
ZKOOL_VIEWER_TOKEN_FILE=var/secrets/testnet-viewer.token   # issued by scripts/zkool-viewer-issuer.ts
ZKOOL_ADDRESS_MODE=rotate            # rotate (unique UA per checkout) | memo (explicit fallback)
# Policy: 1 confirmation for the testnet demo only (documented; NOT zero reorg risk).
REQUIRED_CONFIRMATIONS=1
ZCASH_SPEND_KEY_REF=                 # MUST stay blank on API/worker
P2P_EXECUTION_ENABLED=false
LIVE_PAYOUTS_ENABLED=false
NEXT_PUBLIC_ZEB_MODE=connected
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
