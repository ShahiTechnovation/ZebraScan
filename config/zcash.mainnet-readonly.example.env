# MAINNET_READONLY overlay — SEPARATE deployment, DB, secrets and zkool service from testnet.
# Monitoring only: receiving for customers, payouts, sweeps and refunds all stay closed.
ZEB_ENVIRONMENT=MAINNET_READONLY
ZCASH_NETWORK=mainnet
DATABASE_URL=postgres://<user>:<password>@<host>:5432/zebscan_mainnet_readonly
ZKOOL_GRAPHQL_URL=https://<zebscan-zcash-main>.onrender.com/graphql
ZKOOL_NETWORK=mainnet
ZKOOL_ACCOUNT_ID=<watch-only account id>
ZKOOL_BIRTH_HEIGHT=<birth height>
ZKOOL_VIEWER_TOKEN_FILE=var/secrets/mainnet-viewer.token   # issued by scripts/zkool-viewer-issuer.ts (separate key)
ZCASH_SPEND_KEY_REF=
P2P_EXECUTION_ENABLED=false
MAINNET_PAYMENTS_ENABLED=false
LIVE_PAYOUTS_ENABLED=false
PAYOUT_OPERATOR_APPROVAL_REQUIRED=true
