# ─────────────────────────────────────────────────────────────────────────────
# Zeb Scan configuration. NO real credentials or private keys belong in this file.
# Copy to .env (git-ignored). Generate secrets with:  pnpm exec tsx scripts/gen-dev-secrets.ts
# ─────────────────────────────────────────────────────────────────────────────

# Operating mode — parsed strictly; a typo is a fatal boot error.
#   demo | testnet | mainnet-readonly | mainnet-enabled
ZEB_ENVIRONMENT=demo
DATABASE_URL=postgres://zebscan:CHANGE_ME@localhost:5432/zebscan_dev

API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ≥32 chars random. Signs checkout access tokens, CSRF, receipts.
ZEB_TOKEN_SECRET=
# Envelope-encryption KEKs (id:base64-32-bytes[,id:base64]) — LOCAL PROVIDER IS FOR DEMO/TESTNET ONLY.
ZEB_KMS_PROVIDER=local
ZEB_LOCAL_KEKS=
ZEB_ACTIVE_KEK=
# Internal service-to-service HMAC (in addition to mTLS at the internal ingress), ≥32 chars.
INTERNAL_HMAC_SECRET=

# Email: none | smtp | dev-file (dev-file refused on mainnet)
EMAIL_MODE=dev-file
EMAIL_DEV_DIR=./var/dev-mail
# SMTP_URL=smtps://user:pass@smtp.example:465
# EMAIL_FROM="Zeb Scan <no-reply@example>"

# ── Zcash gateway (testnet/mainnet only; leave unset → receiving stays closed) ──
# ZCASH_NETWORK=testnet
# ZCASH_GATEWAY_URL=https://zcash-gateway.internal:8443
# ZCASH_GATEWAY_TLS_CERT=/secrets/api-client.crt
# ZCASH_GATEWAY_TLS_KEY=/secrets/api-client.key
# ZCASH_GATEWAY_TLS_CA=/secrets/internal-ca.crt

# ── P2P.me on Base (leave unset → payouts/withdrawals stay closed) ──
# Values MUST come from the provider and be verified (pnpm verify:prod-config). No placeholders.
# P2P_CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# P2P_DIAMOND_ADDRESS=
# P2P_SUBGRAPH_URL=
# P2P_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # Circle USDC, Base Sepolia
# P2P_DIAMOND_CODE_HASH=
# TREASURY_ADDRESS=
# BASE_SIGNER_MODE=none            # none | testnet-file (Base Sepolia only) | remote
# BASE_SIGNER_KEY_FILE=/run/secrets/base-sepolia-signer
# BASE_SIGNER_URL=https://signer.internal

# ── Price feeds ──
PRICE_SOURCES=coingecko,kraken
# COINGECKO_API_KEY=

# ── Approvals (mainnet-enabled refuses to open money features without both) ──
# LEGAL_APPROVAL_REF=
# PROVIDER_APPROVAL_REF=

# ── Policy (all optional; conservative proposals, NOT partner facts) ──
# QUOTE_LIFETIME_SECONDS=600
# FUNDING_GRACE_SECONDS=300
# REQUIRED_CONFIRMATIONS=10
# PLATFORM_FEE_BPS=50
# CREDIT_COOLDOWN_SECONDS=1296000
# MAX_INR_PAISE=200000

# ── Web (public, build-time) ──
NEXT_PUBLIC_ZEB_MODE=connected
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── 2026-11-04 delta: modes, TinyFish payout rail, testnet watcher ──
# ZEB_ENVIRONMENT also accepts: DEMO | HACKATHON_TESTNET | MAINNET_READONLY | CONTROLLED_LIVE_PILOT
# Payout rail: P2P_TINYFISH_WEB (default outside DEMO) | DEMO_SIMULATED (DEMO only)
# PAYOUT_RAIL=P2P_TINYFISH_WEB
# Server/worker only — never NEXT_PUBLIC. Get one at https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=
# Exact allowlisted start URL (app.p2p.me or app.p2p.lol only)
# P2P_ALLOWED_START_URL=https://app.p2p.lol/   (operator chose p2p.lol; app.p2p.me also allowlisted)
# Only if a NON-default Browser Context Profile is verified:
# TINYFISH_PROFILE_ID=
# Pilot policy (blocks live payouts by default)
# LIVE_PAYOUTS_ENABLED=false
# PILOT_MAX_PAYOUT_INR_PAISE=0
# PILOT_DAILY_MAX_USDC_MICROS=0
# OPERATOR_APPROVAL_TTL_SECONDS=900
# HACKATHON_TESTNET only, strict opt-in (default false): a confirmed testnet Scan & Pay payment only AUTHORIZES an
# operator-approved INR payout paid from Zeb Scan's OWN pre-funded P2P.lol USDC (TAZ has no value). Requires
# LIVE_PAYOUTS_ENABLED=true, 0 < PILOT_MAX_PAYOUT_INR_PAISE <= 20000, 0 < PILOT_DAILY_MAX_USDC_MICROS <= 3000000.
# TESTNET_LIVE_PAYOUT_DEMO=false
# HACKATHON_TESTNET watch-only watcher: zkool_graphql with a UFVK (uviewtest…) account + birth height.
# Demo wallet placeholders (never a spending key or seed):
# DEMO_WALLET_UTEST1_ADDRESS=utest1...
# DEMO_WALLET_UFVK=uviewtest...   # label: viewing key — reveals history, cannot spend
# ZKOOL_GRAPHQL_URL=http://127.0.0.1:8000/graphql
# ZKOOL_ACCOUNT_ID=1
# ZKOOL_ADDRESS_POOLS=4          # Ironwood-only UA
# REQUIRED_CONFIRMATIONS=1        # testnet evidence demo only

# Render blueprint deployment / management API
# RENDER_API_KEY=
